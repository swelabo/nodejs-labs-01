{
  "name": "nodejs-architecture-labs",
  "version": "0.1.0",
  "private": true,
  "description": "An executable architecture laboratory for experienced Python and Go developers learning Node.js.",
  "type": "module",
  "engines": {
    "node": ">=26.13.0"
  },
  "scripts": {
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "docs:lint": "python3 docs/scripts/lint_docs.py docs --banned docs/assets/checklists/banned-words.txt --check-links",
    "verify:apps": "node scripts/verify-apps.mjs",
    "verify:contracts": "node scripts/verify-contracts.mjs",
    "verify:start": "node scripts/verify-start.mjs",
    "verify:structure": "node scripts/verify-structure.mjs",
    "test": "node --test simple-01/url-shortener/test/url-shortener.test.js simple-01/pastebin/test/pastebin.test.js simple-01/blog/test/blog.test.js"
  },
  "devDependencies": {
    "vitepress": "1.6.4"
  }
}

