{
  "name": "hexagonal-01-blog",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.13.0"
  },
  "scripts": {
    "frontend:build": "node ../../scripts/build-frontend.mjs && npx @tailwindcss/cli -i src/public/input.css -o src/public/styles.css --minify",
    "prestart": "npm run frontend:build",
    "pretest": "node ../../scripts/prepare-test-db.mjs",
    "test": "NODE_ENV=test node --test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "node ../../scripts/seed-prisma.mjs",
    "start": "node src/server.js"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "7.10.1",
    "@prisma/client": "7.10.1",
    "alpinejs": "^3.17.5",
    "better-sqlite3": "13.0.3",
    "ejs": "^7.0.2",
    "express": "5.3.0",
    "htmx.org": "^2.0.11"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "prisma": "7.10.1",
    "supertest": "7.3.1"
  }
}
