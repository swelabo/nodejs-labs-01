<!doctype html>
<html lang="en">
  <head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Snippet <%= snippet.id %></title></head>
  <body style="font-family: system-ui; max-width: 72rem; margin: 2rem auto; padding: 0 1rem; color: #172033;">
    <p><a href="/">Back to public snippets</a></p>
    <h1>Snippet <%= snippet.id %></h1>
    <p>Language: <%= snippet.language %> · Visibility: <%= snippet.visibility %></p>
    <pre style="overflow: auto; background: #f3f4f6; padding: 1rem;"><code><%= snippet.content %></code></pre>
  </body>
</html>

