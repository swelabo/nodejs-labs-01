<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width"><title>Blog administration</title></head><body style="font-family: system-ui; max-width: 56rem; margin: 2rem auto; padding: 0 1rem;"><h1>Blog administration</h1><h2>Posts</h2><ul><% posts.forEach((post) => { %><li><%= post.title %> — <%= post.status %></li><% }) %></ul><h2>Pages</h2><ul><% pages.forEach((page) => { %><li><%= page.title %> — <%= page.status %></li><% }) %></ul></body></html>
