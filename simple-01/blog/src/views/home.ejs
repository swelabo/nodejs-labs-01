<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Blog</title></head><body style="font-family: system-ui; max-width: 56rem; margin: 2rem auto; padding: 0 1rem;"><h1>Engineering Blog</h1><p>Published posts are selected by status and publication time.</p><% posts.forEach((post) => { %><article><h2><a href="/posts/<%= encodeURIComponent(post.slug) %>"><%= post.title %></a></h2><p>By <%= post.author_name %> · <%= post.publish_at || post.created_at %></p></article><% }) %></body></html>

