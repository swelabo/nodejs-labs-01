<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>URL Shortener</title>
    <link rel="stylesheet" href="/styles.css">
    <script defer src="/vendor/alpine.min.js"></script>
    <script src="/vendor/htmx.min.js"></script>
  </head>
  <body class="bg-slate-100 text-slate-900">
    <main class="mx-auto max-w-4xl space-y-8 p-8" x-data>
      <header>
        <p class="text-sm font-semibold uppercase tracking-wide text-blue-700">Node.js Architecture Labs</p>
        <h1 class="mt-2 text-3xl font-bold">URL Shortener</h1>
        <p class="mt-2 text-slate-600">Direct Express handlers, SQLite, and a small browser workflow.</p>
      </header>

      <% if (error) { %>
        <div role="alert" class="rounded border border-red-300 bg-red-50 p-4 text-red-800"><%= error %></div>
      <% } %>

      <section class="rounded bg-white p-6 shadow">
        <h2 class="text-xl font-semibold">Create a link</h2>
        <form class="mt-4 grid gap-3" method="post" action="/links" hx-post="/links" hx-target="#link-list" hx-swap="afterbegin">
          <% if (csrfToken) { %><input type="hidden" name="_csrf" value="<%= csrfToken %>"><% } %>
          <label>Destination URL <input class="mt-1 w-full rounded border p-2" name="destination_url" type="url" required maxlength="2048" placeholder="https://example.com"></label>
          <label>Custom alias <input class="mt-1 w-full rounded border p-2" name="alias" minlength="3" maxlength="64" pattern="[a-zA-Z0-9_-]+" placeholder="optional"></label>
          <button class="rounded bg-blue-700 px-4 py-2 font-semibold text-white" type="submit">Create link</button>
        </form>
      </section>

      <section class="rounded bg-white p-6 shadow">
        <h2 class="text-xl font-semibold">Your links</h2>
        <div id="link-list" class="mt-4 divide-y">
          <% if (links.length === 0) { %><p class="py-4 text-slate-600">No links yet.</p><% } %>
          <% links.forEach((link) => { %><%- include('link-row', { link, userId }) %><% }) %>
        </div>
      </section>
    </main>
  </body>
</html>

