{
  "name": "simple-01-url-shortener",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The direct-handler URL shortener from Node.js Architecture Labs.",
  "engines": {
    "node": ">=26.13.0"
  },
  "scripts": {
    "frontend:build": "node ../../scripts/build-frontend.mjs && npx @tailwindcss/cli -i src/public/input.css -o src/public/styles.css --minify",
    "prestart": "npm run frontend:build",
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test",
    "db:init": "node src/db/init.js",
    "db:seed": "node src/db/seed.js"
  },
  "dependencies": {
    "alpinejs": "^3.17.5",
    "better-sqlite3": "13.0.3",
    "ejs": "7.0.2",
    "express": "5.3.0",
    "htmx.org": "^2.0.11",
    "qrcode": "1.5.4"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "supertest": "7.3.1",
    "yaml": "2.9.1"
  }
}
