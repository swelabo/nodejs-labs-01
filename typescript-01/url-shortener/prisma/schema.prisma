generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Link {
  alias          String   @id
  destinationUrl String
  ownerId        String?
  active         Boolean  @default(true)
  expiresAt      DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  clicks         Click[]
}

model Click {
  id           Int      @id @default(autoincrement())
  alias        String
  occurredAt   DateTime @default(now())
  referrerHost String?
  link         Link     @relation(fields: [alias], references: [alias], onDelete: Cascade)
  @@index([alias, occurredAt])
}

