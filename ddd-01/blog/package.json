{
  "name": "ddd-01-blog",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.13.0"
  },
  "scripts": {
    "frontend:build": "node ../../scripts/build-frontend.mjs && npx @tailwindcss/cli -i src/public/input.css -o src/public/styles.css --minify",
    "prestart": "npm run frontend:build",
    "start": "tsx src/server.ts",
    "dev": "tsx watch src/server.ts",
    "pretest": "node ../../scripts/prepare-test-db.mjs",
    "test": "NODE_ENV=test tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx ../../scripts/seed-prisma.mjs"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "7.10.1",
    "@prisma/client": "7.10.1",
    "alpinejs": "^3.17.5",
    "better-sqlite3": "13.0.3",
    "ejs": "^7.0.2",
    "express": "5.3.0",
    "htmx.org": "^2.0.11"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@types/express": "5.0.6",
    "@types/node": "24.10.1",
    "@types/supertest": "6.0.3",
    "prisma": "7.10.1",
    "supertest": "7.3.1",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  }
}
